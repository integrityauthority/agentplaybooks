# Microsoft SQL Server container
MSSQL_SA_PASSWORD=replace-with-a-long-random-password
MSSQL_PID=Express
MSSQL_DATABASE=agentplaybooks
MSSQL_PORT=1433

# AgentPlaybooks
APP_PORT=3000
SECRETS_ENCRYPTION_KEY=replace-with-64-hex-characters

# Authentication remains on Supabase until the separate on-prem auth phase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
